<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Watchdog.Core\Watchdog.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\watchdog-dog.png" Condition="Exists('Assets\watchdog-dog.png')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
